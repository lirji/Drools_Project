// 订单折扣规则 — 展示多规则协作、salience 优先级、跨事实关联匹配。
//
// 业务场景: 给一个订单 (Order) + 用户 (Customer)，按下面规则计算折扣，可叠加:
//   - VIP 1/2/3 级: 9.5 / 9 / 8.5 折
//   - 原价满 500: 减 50
//   - 老用户 (注册 ≥ 3 年): 额外 95 折
//   - 大额订单 (原价 > 2000): 额外送一句友好提示 (纯 side-effect 规则)
//
// ⚠️ 关于 update($o) 的取舍 (Drools 新手最容易踩的坑):
//
// update($o) 会通知 Drools "$o 这个 fact 变了，请重新评估所有依赖它的规则"。听起来
// 很自然，但搭配“多条规则都改同一个 fact”的写法会立刻死循环：
//
//   1. VIP 2 规则触发，applyRatioDiscount() 改 finalAmount，调 update($o)
//   2. update 触发重新评估 → Bulk 规则匹配，触发，改 finalAmount，调 update($o)
//   3. update 触发重新评估 → VIP 2 规则的 LHS 仍满足 (vipLevel 还是 2)，又被激活
//   4. ...无限循环
//
// `no-loop true` 只能防"自己的 consequence 重新激活自己"，**不防其他规则的 update
// 间接重新激活自己**。要真正阻断要用 `lock-on-active true` (更严格)，或者用
// `agenda-group` 显式控制阶段。
//
// 但当前规则没有任何 LHS 条件读 `finalAmount`（都看 totalAmount / vipLevel /
// yearsSinceRegistration —— 这些都是不可变字段)，所以根本不需要 update()，直接改
// fact 就行。这是规则设计原则: **改的字段如果没有规则依赖它，就不要 update()。**
//
// 第 3 步会专门玩 update() / modify() / lock-on-active 的真实级联场景。
package rules.discount

import com.lrj.drools.domain.Customer
import com.lrj.drools.domain.Order

// ---------- VIP 折扣 ----------
// salience 越大越先执行 (默认 0)。VIP 折扣优先，因为它是基于"商品原价"的，
// 后面的"满减"如果先执行会把基数算小。
rule "VIP level 3 - 8.5 fold"
    salience 100
    when
        $c: Customer( vipLevel == 3 )
        // customer == $c 是 join: 只有当 Order 关联的 customer 正是上面匹配到的 $c 时才命中
        // （当前能力一次只会插一个 Customer 和一个 Order，所以 join 显得多余，
        //  但在多 Order/多 Customer 同时入会话的场景里它是关键)
        $o: Order( customer == $c )
    then
        $o.applyRatioDiscount(0.85, "VIP 3 级 8.5 折");
end

rule "VIP level 2 - 9 fold"
    salience 100
    when
        $c: Customer( vipLevel == 2 )
        $o: Order( customer == $c )
    then
        $o.applyRatioDiscount(0.9, "VIP 2 级 9 折");
end

rule "VIP level 1 - 9.5 fold"
    salience 100
    when
        $c: Customer( vipLevel == 1 )
        $o: Order( customer == $c )
    then
        $o.applyRatioDiscount(0.95, "VIP 1 级 9.5 折");
end

// ---------- 满减 ----------
rule "Bulk amount discount"
    salience 50
    when
        // 注意这里看的是 totalAmount (原价)，不是 finalAmount —
        // 防止跟 VIP 折扣相互抵消导致到不到门槛
        $o: Order( totalAmount >= 500 )
    then
        $o.applyFixedDiscount(50, "原价满 500 减 50");
end

// ---------- 老用户额外折扣 ----------
rule "Loyal customer extra"
    salience 10
    when
        $c: Customer( yearsSinceRegistration >= 3 )
        $o: Order( customer == $c )
    then
        $o.applyRatioDiscount(0.95, "老用户额外 95 折");
end

// ---------- 大单提示 (纯 side-effect 规则) ----------
rule "Big order greeting"
    salience 1
    when
        $o: Order( totalAmount > 2000 )
    then
        System.out.println("[BigOrder] 大客户订单 " + $o.getOrderId() + " 原价 " + $o.getTotalAmount());
end
