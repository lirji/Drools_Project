<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lrj</groupId>
        <artifactId>activity-platform-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>drools-lab</artifactId>
    <name>drools-lab</name>
    <description>
        Step 1–24 规则能力库：Hello→PMML 的 24 个 Step（controller/service/config/domain/audit/metrics/guard/
        persistence(Step10/18 JPA)/web + rules(drl/xls/dmn) + kmodule.xml）。与 activity 世界零耦合（无 activity.* import）。
        独占重依赖 kie-ci(Step16 KJAR/KieScanner) + kie-dmn(Step17) + decisiontables(Step7) + xml-support(kmodule)——
        这些**不进** activity-common，故 decision 服务不背这些重量级传递依赖。console 服务依赖本库以提供 Step1-24。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Step10/18 JPA 持久化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Step15 可观测性指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Drools 全家桶（教学覆盖 DRL/决策表/KJAR/DMN 全体系） -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-mvel</artifactId>
        </dependency>
        <!-- kmodule.xml 解析（8.x 拆独立模块，不加启动报错，已踩坑） -->
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-xml-support</artifactId>
        </dependency>
        <!-- Step7 决策表 -->
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-decisiontables</artifactId>
        </dependency>
        <!-- Step16 KieScanner+KJAR（重依赖：拉进 maven-core/aether） -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-ci</artifactId>
        </dependency>
        <!-- Step17 DMN（drools-bom 不管 kie-dmn-* 版本，显式锁同版本号） -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-dmn-core</artifactId>
            <version>${drools.version}</version>
        </dependency>
        <!-- Step10 KieSession 持久化 Marshaller -->
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-serialization-protobuf</artifactId>
        </dependency>
        <!-- Step21 traits（动态贴接口做多态）；@Traitable 在 drools-base（已传递），
             don/shed 运行时支持在 drools-traits，8.x 拆成独立模块，不加 don() 拿不到实现 -->
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-traits</artifactId>
        </dependency>
        <!-- Step23 规则模板 .drt（ObjectDataCompiler 把模板 + 数据行展开成 DRL）。
             drools-decisiontables 内部用到它但不传递暴露，显式加一条 -->
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-templates</artifactId>
        </dependency>
        <!-- Step24 PMML/Scorecard（规则里嵌 ML 模型评分 + 评分卡）。8.44.2 无 kie-pmml-trusty
             单一构件，走聚合 pom kie-pmml-dependencies 拉齐 trusty 全栈（regression/tree/
             scorecard/mining 的 compiler+evaluator）。drools-bom 不管其版本，显式锁同版本号。
             standalone 求值走「自己编译进一个 MemoryCompilerClassLoader，再用同一个 classloader
             建 runtime context」的路子（PmmlService），避开 getPMMLRuntimeFromFile 的 classloader 不共享坑 -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-pmml-dependencies</artifactId>
            <version>${drools.version}</version>
            <type>pom</type>
        </dependency>
        <!-- trusty PMML（经 jpmml pmml-model）用 javax.xml.bind(JAXB 2.3 老命名空间) 解析 .pmml；
             Java 21 已从 JDK 移除 JAXB，必须显式补 javax 版 api + RI，否则运行期 "JAXB-API 找不到实现"。
             ⚠ RI 必须用 com.sun.xml.bind:jaxb-impl（javax 版），**不能**用 org.glassfish.jaxb:jaxb-runtime：
             后者被 Spring Boot 3 的 BOM 统一管到 4.0.5（jakarta 版，同 GAV 无法并存），只注册 jakarta 服务，
             javax 发现不到实现 → console fat jar 启动即崩。jaxb-impl 是独立 GAV，与 glassfish 4.0.5 并存。 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>2.3.1</version>
        </dependency>
        <!-- Step25 Rule Units 曾尝试接入(drools-ruleunits-impl)，2026-08-17 回退：它与 drools-traits(Step21)
             争抢 Drools 唯一的 RuntimeComponentFactory SPI 单例、二者互斥(加它 traits 就 ClassCastException)，
             且其解释执行 provider 在 Spring Boot fat jar 里扫不到自己的 DRL 资源(NoSuchFileException on nested jar)。
             surefire 扁平 classpath 测得过、打包部署即崩。详见 docs/plans/drools-capabilities-tier3-*/ §5。 -->



        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
