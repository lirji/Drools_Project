<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lrj</groupId>
    <artifactId>drools-demo-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>drools-demo-parent</name>
    <description>
        M2.1 微服务化物理拆分：聚合 pom。四模块——
        activity-common(共享库：domain/engine/persistence/tenant + 读服务) /
        drools-lab(库：Step1-18 教学 + 重 drools 依赖) /
        activity-console(应用：写平面 + Step1-18) / activity-decision(应用：只读决策平面)。
        决策别名/角色门控见 activity-common；两 app 各自可独立启动(console:8081, decision:8082)。
    </description>

    <modules>
        <module>activity-common</module>
        <module>drools-lab</module>
        <module>activity-console</module>
        <module>activity-decision</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <drools.version>8.44.2.Final</drools.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- org.kie:kie-bom 在 8.44.2 没发布 → 用 org.drools:drools-bom（已踩坑） -->
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-bom</artifactId>
                <version>${drools.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 内部模块版本统一由父 version 管，子模块引用不写 version -->
            <dependency>
                <groupId>com.lrj</groupId>
                <artifactId>activity-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj</groupId>
                <artifactId>drools-lab</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
