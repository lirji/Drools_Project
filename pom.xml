<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lrj</groupId>
    <artifactId>activity-platform-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>activity-platform-parent</name>
    <description>
        M2.1 微服务化物理拆分：聚合 pom。四模块——
        activity-common(共享库：domain/engine/persistence/tenant + 读服务) /
        drools-lab(库：Step1-24 规则能力 + 重 Drools 依赖) /
        activity-console(应用：写平面 + Step1-24) / activity-decision(应用：只读决策平面)。
        决策别名/角色门控见 activity-common；两 app 各自可独立启动(console:8081, decision:8082)。
    </description>

    <modules>
        <module>activity-common</module>
        <module>drools-lab</module>
        <module>activity-console</module>
        <module>activity-decision</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <drools.version>8.44.2.Final</drools.version>
        <xxl-job.version>3.4.2</xxl-job.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- org.kie:kie-bom 在 8.44.2 没发布 → 用 org.drools:drools-bom（已踩坑） -->
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-bom</artifactId>
                <version>${drools.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Step24 PMML(经 jpmml)要 javax 版 JAXB。Spring Boot 3 的 BOM 会把 jaxb-impl / jaxb-api
                 这两个 GAV 统一管到 4.0.5(jakarta 命名空间)，导致 console fat jar 里装的是 jakarta 版、
                 javax.xml.bind 运行期发现不到实现启动即崩（dependency:tree 看着是 2.3.1、fat jar 里却是 4.0.5，
                 极具迷惑性）。这里在父 dependencyManagement 直接 pin 回 2.3.1(javax) 覆盖 Spring Boot BOM。
                 只影响这两个专供 jpmml 的 GAV；Spring Boot 自身的 jakarta JAXB 走 glassfish:jaxb-runtime:4.0.5，不动。 -->
            <dependency>
                <groupId>com.sun.xml.bind</groupId>
                <artifactId>jaxb-impl</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>
            <!-- 内部模块版本统一由父 version 管，子模块引用不写 version -->
            <dependency>
                <groupId>com.lrj</groupId>
                <artifactId>activity-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj</groupId>
                <artifactId>drools-lab</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
