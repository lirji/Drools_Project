{
  "name": "drools-console-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "活动引擎控制台 + Drools 18 Step 演示台的前端工程（前后端分离，Vue3+Vite+TS）。产物挂载在后端 /ui/。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:dev": "node e2e/e2e-dev-v2.mjs",
    "e2e:oidc": "node e2e/e2e-oidc-v2.mjs",
    "e2e:catalog": "node e2e/e2e-catalog-v2.mjs",
    "e2e:tablet": "node e2e/e2e-tablet-smoke.mjs",
    "e2e:phone": "node e2e/e2e-phone-smoke.mjs",
    "e2e:ruler": "node e2e/e2e-tier-ruler.mjs",
    "e2e:bench": "node e2e/e2e-bench.mjs",
    "e2e:playbooks": "node e2e/e2e-playbooks.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
