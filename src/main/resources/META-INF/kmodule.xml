<?xml version="1.0" encoding="UTF-8"?>
<!--
  kmodule.xml: Drools 的"模块描述符"，告诉 KIE 在 classpath 里怎么组装 KieBase / KieSession。

  - kbase: 一组规则的集合，name 唯一；packages 指 classpath 下的目录 (rules/* → 加载 src/main/resources/rules/ 下所有 *.drl)
  - ksession: 从 kbase 派生出来的运行时会话；name 唯一，是代码里 kieContainer.newKieSession("xxx") 拿的那个名字
  - 一个 kmodule.xml 里可以挂多个 kbase；不同 kbase 可以挂不同 packages，做规则隔离
-->
<kmodule xmlns="http://www.drools.org/xsd/kmodule">

    <kbase name="helloKBase" packages="rules.hello">
        <ksession name="helloSession"/>
    </kbase>

    <kbase name="discountKBase" packages="rules.discount">
        <ksession name="discountSession"/>
        <!-- Step 11: 同一组规则挂第二个 ksession, type="stateless" 让 KieContainer
             派生出 StatelessKieSession。同样的 DRL, 不同的 session 模型, 用来对比
             stateful 跟 stateless 的 API / 状态管理 / 复用性差别。 -->
        <ksession name="discountStatelessSession" type="stateless"/>
    </kbase>

    <kbase name="cartKBase" packages="rules.cart">
        <ksession name="cartSession"/>
    </kbase>

    <!-- Step 4: not / exists 演示 (风控 + 推荐)。跟 cartKBase 隔离，
         Step 5 会用 agenda-group 把它们合到一个 kbase 里分阶段触发。 -->
    <kbase name="riskKBase" packages="rules.risk">
        <ksession name="riskSession"/>
    </kbase>

    <!-- Step 5: agenda-group 流水线 (validate → discount → risk → notify)。
         独立 kbase 避免跟 Step 2/4 原 demo 互相污染; 规则跟前面相似但每条都标了
         agenda-group, 演示 setFocus 栈式控制 + auto-focus + lock-on-active。 -->
    <kbase name="pipelineKBase" packages="rules.pipeline">
        <ksession name="pipelineSession"/>
    </kbase>

    <!-- Step 7: 决策表. packages 指向的目录里的 .csv/.xls/.xlsx 会被
         drools-decisiontables 模块自动当决策表编译成 DRL。 -->
    <kbase name="decisionKBase" packages="rules.decision">
        <ksession name="decisionSession"/>
    </kbase>

    <!-- Step 8: CEP. eventProcessingMode=stream 让 kbase 启用事件时间线 / 滑窗 / 过期;
         clockType=pseudo 用人工推进的时钟, 让测试能精确控制 "现在是什么时间"。
         生产环境改成 realtime, 用机器时钟即可。 -->
    <kbase name="fraudKBase" packages="rules.fraud" eventProcessingMode="stream">
        <ksession name="fraudSession" clockType="pseudo"/>
    </kbase>

    <!-- Step 10: KieSession 持久化。规则集本身没特别配置, 跟普通 kbase 一样;
         Marshaller 在 LoyaltyService 里按需 marshall/unmarshall 整个 session 状态。 -->
    <kbase name="loyaltyKBase" packages="rules.loyalty">
        <ksession name="loyaltySession"/>
    </kbase>

    <!-- Step 12: TMS 对照组。同样的业务规则各写一份, 一份用 insertLogical,
         一份用普通 insert, 让 demo 在同一次请求里跑两遍展示差异。
         隔离成两个 kbase 是为了避免"两份规则跑在同一 working memory 里互相污染"。 -->
    <kbase name="tmsLogicalKBase" packages="rules.tms.logical">
        <ksession name="tmsLogicalSession"/>
    </kbase>
    <kbase name="tmsRegularKBase" packages="rules.tms.regular">
        <ksession name="tmsRegularSession"/>
    </kbase>

    <!-- Step 13: 后向链 + query。query 在 Drools 里是声明式查询模式,
         可以 (1) Java 侧通过 session.getQueryResults 拉取结果, 也可以
         (2) 规则 LHS 里用 ?queryName(...) 反向触发递归推理。
         经典 isContainedIn 例子: 给一组 Location(thing, container), 查询 A 是否
         (递归地) 在 B 里面。 -->
    <kbase name="backwardKBase" packages="rules.backward">
        <ksession name="backwardSession"/>
    </kbase>

    <!-- Step 14: 引擎安全护栏。一个 kbase 同时放"失控循环规则" (Counter 触发) 和
         "灰度规则" (Cart 触发, 带 @release 元数据), 靠 fact 类型天然隔离。
         演示 fireAllRules(maxFires) 熔断、session.halt() 超时打断、
         fireAllRules(AgendaFilter) 按发布通道灰度放行。 -->
    <kbase name="guardKBase" packages="rules.guard">
        <ksession name="guardSession"/>
    </kbase>

    <!-- Step 17: DMN。packages 指向 rules.dmn 目录, 里面的 .dmn 模型被
         kie-dmn-core 编译。注意 DMN 不靠 ksession 跑, 而是从这个 kbase 取
         DMNRuntime (KieRuntimeFactory.of(kieBase("dmnKBase")).get(DMNRuntime.class)),
         所以这里只声明 kbase, 不需要 ksession。 -->
    <kbase name="dmnKBase" packages="rules.dmn"/>

</kmodule>
